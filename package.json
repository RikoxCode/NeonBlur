{
  "name": "NeonBlur",
  "version": "1.0.0",
  "description": "Modern Jellyfin Theme with SCSS",
  "main": "main.scss",
  "scripts": {
    "build": "sass main.scss:dist/neonblur-theme.css",
    "build:min": "sass --style compressed main.scss:dist/neonblur-theme.min.css",
    "watch": "sass --watch main.scss:dist/neonblur-theme.css",
    "dev": "sass --watch --style expanded main.scss:dist/neonblur-theme.css"
  },
  "keywords": [
    "jellyfin",
    "theme",
    "scss",
    "css"
  ],
  "author": "RikoxCode",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.69.0"
  }
}
